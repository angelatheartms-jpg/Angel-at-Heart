<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Angel at Heart</title>
    <style>
        body { background-color: #f9f3f3; color: #5d3a8a; font-family: Arial, sans-serif; }
        header { text-align: center; padding: 50px; }
        .hero { background-color: #eAB8E4; padding: 20px; }
        .services, .testimonial, .donation, .newsletter { padding: 20px; margin: 10px; border-radius: 10px; }
        .impact-card { display: flex; flex-direction: column; align-items: center; margin: 20px; padding: 10px; border: 1px solid #5d3a8a; border-radius: 8px; }
        footer { text-align: center; padding: 20px; background-color: #eAB8E4; }
        .animation { transition: transform 0.3s ease; }
        .animation:hover { transform: scale(1.05); }
    </style>
</head>
<body>
    <header>
        <h1>Welcome to Angel at Heart</h1>
        <p>Your support changes lives!</p>
    </header>
    <section class="hero animation">
        <h2>Making a Difference</h2>
        <img src="your-image-source.jpg" alt="Angel at Heart" style="width:100%;">
    </section>
    <section class="services">
        <h2>Our Services</h2>
        <ul>
            <li>Service 1</li>
            <li>Service 2</li>
            <li>Service 3</li>
        </ul>
    </section>
    <section class="testimonial">
        <h2>Testimonials</h2>
        <blockquote>
            <p>This organization has changed my life!</p>
            <footer>- Happy Donor</footer>
        </blockquote>
    </section>
    <section class="impact">
        <h2>Impact Cards</h2>
        <div class="impact-card">
            <h3>Impact Card 1</h3>
            <p>Description of impact card 1.</p>
        </div>
        <div class="impact-card">
            <h3>Impact Card 2</h3>
            <p>Description of impact card 2.</p>
        </div>
    </section>
    <section class="donation">
        <h2>Donate Now</h2>
        <p>We accept donations through PayPal and Zelle.</p>
        <button>Donate with PayPal</button>
        <button>Donate with Zelle</button>
    </section>
    <section class="newsletter">
        <h2>Sign Up for Our Newsletter</h2>
        <form>
            <input type="email" placeholder="Enter your email" required>
            <button type="submit">Subscribe</button>
        </form>
    </section>
    <footer>
        <p>&copy; 2026 Angel at Heart</p>
    </footer>
</body>
</html>
