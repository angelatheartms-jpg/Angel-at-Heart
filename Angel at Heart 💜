<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Angel at Heart Charity</title>

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(to bottom, #fdf2f8, #ffffff);
      color: #374151;
    }

    .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 48px 16px;
      text-align: center;
    }

    h1 {
      color: #db2777;
      font-size: 2.5rem;
      margin-bottom: 16px;
    }

    p {
      max-width: 600px;
      margin: 0 auto 24px;
      font-size: 1.1rem;
    }

    .buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 64px;
    }

    .btn {
      padding: 14px 28px;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }

    .btn-primary {
      background-color: #db2777;
      color: white;
      border: none;
    }

    .btn-outline {
      background: transparent;
      color: #db2777;
      border: 2px solid #db2777;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }

    .card {
      padding: 24px;
      border-radius: 16px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    footer {
      margin-top: 64px;
      padding: 24px;
      text-align: center;
      color: #6b7280;
      font-size: 0.9rem;
    }
  </style>
</head>

<body>

  <div class="container">
    <h1>Angel at Heart Charity</h1>

    <p>
      Spreading love, hope, and compassion to individuals and families in need.
    </p>

    <div class="buttons">
      <a
        class="btn btn-primary"
        href="https://www.paypal.com/donate/?business=YOUR_PAYPAL_EMAIL&currency_code=USD"
        target="_blank"
        rel="noopener noreferrer"
      >
        One‑Time Donation
      </a>

      <a
        class="btn btn-outline"
        href="https://www.paypal.com/donate/?business=YOUR_PAYPAL_EMAIL&currency_code=USD"
        target="_blank"
        rel="noopener noreferrer"
      >
        Monthly Donation
      </a>
    </div>

    <div class="grid">
      <div class="card">
        <h3>Our Mission</h3>
        <p>To serve with kindness and uplift hearts through charitable outreach.</p>
      </div>

      <div class="card">
        <h3>What We Do</h3>
        <p>Food drives, community support, care packages, and emergency assistance.</p>
      </div>

      <div class="card">
        <h3>Get Involved</h3>
        <p>Volunteer, partner, or support us to make a difference.</p>
      </div>
    </div>
  </div>

  <footer>
    © <span id="year"></span> Angel at Heart Charity. All rights reserved.
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>

</body>
</html>
